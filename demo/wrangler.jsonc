{
	"name": "pi-withblobs-demo",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [{ "name": "AGENT", "class_name": "AgentObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentObject"] }],
	"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "pi-withblobs-demo" }]
}
